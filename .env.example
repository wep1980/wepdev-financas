# Copie este arquivo pra ".env" (gitignored) e ajuste os valores.
# Os valores abaixo são os defaults de DEV — funcionam sem nenhuma
# alteração pra rodar local (docker compose up -d), mas NUNCA devem ser
# reaproveitados em produção. Produção usa valores fortes injetados via
# Vault/variável de ambiente do servidor, nunca este arquivo.
# Ver docs/architecture/security.md.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=financas
MYSQL_PASSWORD=financas

# ---- MongoDB ----
MONGO_ROOT_USER=financas
MONGO_ROOT_PASSWORD=financas

# ---- Keycloak ----
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=admin

# ---- OIDC client credentials (serviço-a-serviço, ADR-0003) ----
# Secret do client "transaction-service" no Keycloak — usado pra chamar os
# endpoints internos do account-service (/debitos, /creditos) via
# client_credentials. Mesmo valor de "infra/keycloak/realm-financas.json".
TRANSACTION_SERVICE_CLIENT_SECRET=changeit

# ---- IA (preenchido pelo usuário final, não pelo time de dev) ----
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
