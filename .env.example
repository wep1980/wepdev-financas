# Copie este arquivo pra ".env" (gitignored) e ajuste os valores.
# Os valores abaixo são os defaults de DEV — funcionam sem nenhuma
# alteração pra rodar local (docker compose up -d), mas NUNCA devem ser
# reaproveitados em produção. Produção usa valores fortes injetados via
# Vault/variável de ambiente do servidor, nunca este arquivo.
# Ver docs/architecture/security.md.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=financas
MYSQL_PASSWORD=financas

# ---- MongoDB ----
MONGO_ROOT_USER=financas
MONGO_ROOT_PASSWORD=financas

# ---- Keycloak ----
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=admin

# ---- OIDC client credentials (serviço-a-serviço, ADR-0003) ----
# Secret do client "transaction-service" no Keycloak — usado pra chamar os
# endpoints internos do account-service (/debitos, /creditos) via
# client_credentials. Mesmo valor de "infra/keycloak/realm-financas.json".
TRANSACTION_SERVICE_CLIENT_SECRET=changeit
# Secret do client "card-service" — usado pra confirmar posse de
# contaPagamentoId (GET /contas/{id}) via client_credentials.
CARD_SERVICE_CLIENT_SECRET=changeit

# ---- IA (preenchido pelo usuário final, não pelo time de dev) ----
# OPENAI_API_KEY=

# ---- Ollama compartilhado (ADR-0029) ----
# Instância padrão usada pelo document-service (extração de fatura,
# sempre) e pelo ai-service (chat/RAG, provedor OLLAMA default e
# embeddings). A partir de 2026-08-11 não roda mais neste
# docker-compose.yml — vive no servidor, numa GPU dedicada (Ollama numa
# CPU sem GPU não aguenta chat + extração de fatura ao mesmo tempo, ver
# docs/historico.md e ADR-0029 pro achado completo). Endereço real
# (IP da rede local) só aqui, nunca em arquivo versionado. Sem GPU
# disponível, dá pra apontar de volta pra um Ollama local — nesse caso
# suba um container `ollama/ollama` à parte e use
# "http://localhost:11434" aqui.
OLLAMA_SERVER_URL=http://SEU_SERVIDOR_AQUI:11434

# ---- Auth.js do serviço "web" (NextAuth v5, ADR-0027) ----
# Assina/criptografa o cookie de sessão. Default abaixo é o mesmo já usado
# em services/web/.env.example pra "npm run dev" — funciona sem alteração
# pra rodar via docker-compose, mas NUNCA reaproveitar em produção (gerar
# valor próprio com "openssl rand -base64 33", via Vault).
AUTH_SECRET=Bw/IG0xCGSqVzl1IyUPZ2nsDrVXV8jy3+oa6K23zT6IO
