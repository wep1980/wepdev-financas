# Copie este arquivo pra ".env.local" (gitignored) e ajuste os valores.
# Os valores abaixo já funcionam pra rodar local (npm run dev, com a infra
# do docker-compose.yml no ar) — NUNCA reaproveitar em produção. Ver
# docs/architecture/security.md.

# ---- Auth.js (NextAuth v5) — ADR-0027 ----
# Assina/criptografa o cookie de sessão (JWT). Dev default gerado com
# "openssl rand -base64 33" — produção usa um valor próprio via Vault.
AUTH_SECRET=Bw/IG0xCGSqVzl1IyUPZ2nsDrVXV8jy3+oa6K23zT6IO
# Self-hosted (ADR-0016), não Vercel.
AUTH_TRUST_HOST=true
# URL pública desta aplicação — usada no redirect pós-logout do Keycloak.
AUTH_URL=http://localhost:3000

# ---- Keycloak (client "web-app", público — sem client_secret) ----
AUTH_KEYCLOAK_ID=web-app
# Em dev, navegador e servidor Next.js rodam no mesmo host, então uma URL
# só resolve os dois lados. Se o "web" um dia rodar dentro do
# docker-compose (item 9 do backlog da fatia 6), revisitar — o servidor
# (dentro do container) precisaria de "http://keycloak:8080/realms/financas"
# pras chamadas de troca de token/refresh, enquanto o navegador continua
# precisando de "http://localhost:8080/realms/financas" pro redirect de
# login. Ver docs/tasks.md fatia 6, item 2.
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/financas

# ---- Microsserviços (Route Handler/Server Action propaga o access token
# do usuário logado, nunca client_credentials — ver lib/account-service.ts) ----
ACCOUNT_SERVICE_URL=http://localhost:8081
TRANSACTION_SERVICE_URL=http://localhost:8082
CARD_SERVICE_URL=http://localhost:8083
BUDGET_SERVICE_URL=http://localhost:8085
DOCUMENT_SERVICE_URL=http://localhost:8084
AI_SERVICE_URL=http://localhost:8086
